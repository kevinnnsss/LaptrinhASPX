<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="BCBTL.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Quản Trị Hệ Thống Duy Anh Watch</title>
    <link href="~/Assets/css/admin.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="headAdmin" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="formAdmin" runat="server">
        <asp:ScriptManager ID="smAdmin" runat="server"></asp:ScriptManager>
        <div class="admin-wrapper">
            <!-- 1. SIDEBAR -->
            <aside class="admin-sidebar">
                <div class="admin-brand">
                    <span>👑</span>
                    <div>
                        <h1>DUY ANH <span>ADMIN</span></h1>
                        <small style="color: #a0aec0; font-size: 11px;">Hệ thống Quản trị v2.0</small>
                    </div>
                </div>

                <ul class="admin-nav">
                    <li>
                        <a href="Dashboard.aspx">
                            <span class="nav-icon">📊</span>
                            <span>Bảng Điều Khiển</span>
                        </a>
                    </li>
                    <li>
                        <a href="ManageProducts.aspx">
                            <span class="nav-icon">⌚</span>
                            <span>Quản Lý Sản Phẩm</span>
                        </a>
                    </li>
                    <li>
                        <a href="ManageMenus.aspx">
                            <span class="nav-icon">📑</span>
                            <span>Danh Mục & Thương Hiệu</span>
                        </a>
                    </li>
                    <li>
                        <a href="ManageOrders.aspx">
                            <span class="nav-icon">🛒</span>
                            <span>Quản Lý Đơn Hàng</span>
                        </a>
                    </li>
                    <li>
                        <a href="ManageAccounts.aspx">
                            <span class="nav-icon">👥</span>
                            <span>Quản Lý Tài Khoản</span>
                        </a>
                    </li>
                    <li style="margin-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px;">
                        <a href="../Default.aspx" target="_blank">
                            <span class="nav-icon">🌐</span>
                            <span>Xem Website Khách ▶</span>
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- 2. MAIN WORKSPACE -->
            <div class="admin-main">
                <!-- TOPBAR -->
                <header class="admin-header">
                    <div class="admin-title-area">
                        <h2><%: Page.Title %></h2>
                    </div>
                    <div class="admin-user-area">
                        <span class="admin-badge">Quản Trị Viên</span>
                        <span>Xin chào, <asp:Literal ID="litAdminName" runat="server">Admin</asp:Literal></span>
                        <span style="color:#cbd5e0;">|</span>
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click">Đăng Xuất [✖]</asp:LinkButton>
                    </div>
                </header>

                <!-- PAGE CONTENT -->
                <main class="admin-content">
                    <asp:ContentPlaceHolder ID="AdminMainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>
</body>
</html>
